# Public app URL used by deployment previews and external callbacks.
VITE_APP_URL=https://dashboard.shreeayurvedhospital.in

# PostgreSQL connection used by the Node server for cross-device live data.
# In Coolify, connect a PostgreSQL resource and set DATABASE_URL to its internal URL.
DATABASE_URL=postgresql://user:password@postgres:5432/moms_pathshala
# Set to true only when your PostgreSQL connection requires SSL.
POSTGRES_SSL=false
PORT=3000

# Optional external Forms API base URL. Leave blank to use this app's built-in
# same-origin /api forms service for instant cross-device form links.
VITE_FORMS_API_URL=

# Admin login is checked by the Node server. Store only a SHA-256 hash, never plaintext.
ADMIN_EMAIL=shreeayurved09@gmail.com
ADMIN_PASSWORD_SHA256=

# Optional external tools. Add real production values in Coolify environment variables.
VITE_GOOGLE_SHEETS_URL=
VITE_WHATSAPP_PHONE_NUMBER=
